{
  "task_description": "{'component_name': 'Main Container for CyberSlate', 'description': 'Primary container for CyberSlate implementation: A cross-platform cybersecurity desktop tool inspired by Burp Suite, built with React.js and Electron. It provides modular features for recon, scanning, exploitation, and reporting, with a dark, tabbed UI. The tool integrates CLI utilities (Amass, Masscan, Nuclei), supports offline session management with SQLite, and offers extensibility via plugins. Designed for security professionals, it enables efficient recon, vulnerability assessment, exploitation, and report generation in a polished, accessible interface.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Recon Dashboard",\n      "description": "Input domains, run Amass and Masscan via Electron backend, visualize results in graph/table, export to CSV/JSON, and cache recon history in SQLite.",\n      "isEnabled": true\n    },\n    {\n      "name": "Vulnerability Scanner",\n      "description": "Integrate Nuclei CLI for vulnerability scanning (XSS, SQLi, etc.), filter templates, display findings, generate PoC snippets, and export results.",\n      "isEnabled": true\n    },\n    {\n      "name": "Exploitation Toolkit",\n      "description": "Built-in proxy with start/stop, dual-pane request/response viewer, request replay, JWT/Base64 decoder, and session timeline.",\n      "isEnabled": true\n    },\n    {\n      "name": "JS Debugger",\n      "description": "Paste/upload JS/HTML, extract secrets/tokens/endpoints using regex, and display results in a live-updating table.",\n      "isEnabled": true\n    },\n    {\n      "name": "Wordlist Generator",\n      "description": "Paste/upload JS/HTML, run TF-IDF analysis in-browser, and export high-priority keywords for use in attacks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Report Generator",\n      "description": "Markdown editor with live preview, screenshot uploads, auto-insert findings, and export to PDF/HTML.",\n      "isEnabled": true\n    },\n    {\n      "name": "Bug Bounty Aggregator",\n      "description": "Fetch programs from HackerOne, Bugcrowd, Intigriti, filter by bounty/platform, and add domains to Recon module.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settings/Plugin Manager",\n      "description": "Configure API keys, proxy settings, and manage optional plugins (CVE tools, payload generators).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#23272e",\n    "secondary": "#181a20",\n    "accent": "#ff9800"\n  },\n  "theme": "light",\n  "layoutDescription": "Tabbed interface with a persistent sidebar for module navigation (Recon, Scanner, Exploitation, Debugger, Wordlist, Reports, Bounty, Settings). Each module opens in a main content area with sub-tabs or panels as needed. Dark theme with Burp Suite-inspired styling, accessible controls, and responsive design. Graphs, tables, and editors are styled for clarity and usability."\n}'}",
